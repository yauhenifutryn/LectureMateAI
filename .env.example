# Required
GEMINI_API_KEY=
GCS_BUCKET=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Required in production
SYSTEM_INSTRUCTIONS=
ADMIN_PASSWORD=
CLOUD_TASKS_PROJECT_ID=
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE_ID=
WORKER_TASK_URL=
WORKER_TASK_SERVICE_ACCOUNT_EMAIL=

# Optional KV (only needed when STORE_BACKEND=upstash)
KV_REST_API_READ_ONLY_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_READ_ONLY_TOKEN=

# Store backend selector: 'firestore' (default) or 'upstash'
STORE_BACKEND=firestore
# Firestore (used when STORE_BACKEND=firestore)
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE_ID=(default)

# Optional local fallback (replaces Cloud Tasks for local dev)
WORKER_URL=
WORKER_SHARED_SECRET=

# Optional overrides
GEMINI_MODEL_ID=
SPEECH_TO_TEXT_PROJECT_ID=
SPEECH_TO_TEXT_LOCATION=us
TRANSCRIPT_LANGUAGE_CODES=auto
MAX_UPLOAD_BYTES=
GCS_UPLOAD_URL_TTL_SECONDS=
GCS_RESULT_URL_TTL_SECONDS=
JOB_TTL_SECONDS=
PORT=8080
